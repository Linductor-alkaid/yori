# 静态检查（M0-04）：CI 以 clang-tidy-18 校验；关键类别按 WarningsAsErrors 设为
# error（工程规范第 11 节）。仅检查仓库自研代码，third_party/ 排除。
Checks: >
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -modernize-avoid-c-arrays,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers

WarningsAsErrors: 'bugprone-*,clang-analyzer-*,performance-*,portability-*'
HeaderFilterRegex: '^(include|src|apps|tests)/.*\.hpp$'
FormatStyle: file
